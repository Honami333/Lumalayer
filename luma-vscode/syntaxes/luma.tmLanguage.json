{
  "scopeName": "source.luma",
  "name": "Luma",
  "patterns": [
    { "include": "#comment" },
    { "include": "#use" },
    { "include": "#hit-block" },
    { "include": "#widget" },
    { "include": "#string" },
    { "include": "#color" },
    { "include": "#size" },
    { "include": "#number" },
    { "include": "#boolean" },
    { "include": "#image-handle" },
    { "include": "#property" },
    { "include": "#enum" },
    { "include": "#name-ref" },
    { "include": "#punct" },
    { "include": "#arrow" }
  ],
  "repository": {
    "comment": {
      "match": "//.*$",
      "name": "comment.line.double-slash.luma"
    },

    "use": {
      "begin": "\\buse\\b",
      "beginCaptures": {
        "0": { "name": "keyword.other.use.luma" }
      },
      "end": ";",
      "endCaptures": {
        "0": { "name": "punctuation.definition.generic.end.luma" }
      },
      "patterns": [
        { "include": "#comment" },
        {
          "match": "\\bcrate\\b",
          "name": "keyword.other.use.luma"
        },
        {
          "match": "\\bsuper\\b",
          "name": "variable.language.super.luma"
        },
        {
          "match": "::",
          "name": "punctuation.separator.namespace.luma"
        },
        {
          "match": "[{},]",
          "name": "punctuation.definition.generic.begin.luma"
        },
        {
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b",
          "name": "entity.name.type.luma"
        },
        {
          "match": "\\b[a-z_][a-z0-9_]*\\b",
          "name": "entity.name.namespace.luma"
        }
      ]
    },
    
    "hit-block": {
      "begin": "\\b(HitVec|HitMap)\\b\\s*(<)([^>]*)(>)\\s*(\\{)",
      "beginCaptures": {
        "1": { "name": "entity.name.type.luma" },
        "2": { "name": "punctuation.definition.generic.begin.luma" },
        "3": { "name": "entity.name.type.luma" },
        "4": { "name": "punctuation.definition.generic.end.luma" },
        "5": { "name": "punctuation.definition.generic.begin.luma" }
      },
      "end": "\\}",
      "endCaptures": {
        "0": { "name": "punctuation.definition.generic.end.luma" }
      },
      "patterns": [
        { "include": "#comment" },
        { "include": "#hit-braces" },
        {
          "match": "(=>)\\s*([A-Z][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.operator.arrow.luma" },
            "2": { "name": "keyword.other.use.luma" }
          }
        },
        { "include": "#arrow" },
        { "include": "source.rust" }
      ]
    },

    "hit-braces": {
      "begin": "\\{",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.generic.begin.luma" }
      },
      "end": "\\}",
      "endCaptures": {
        "0": { "name": "punctuation.definition.generic.end.luma" }
      },
      "patterns": [
        { "include": "#comment" },
        { "include": "#hit-braces" },
        { "include": "source.rust" }
      ]
    },

    "arrow": {
      "match": "=>",
      "name": "keyword.operator.arrow.luma"
    },

    "widget": {
      "match": "\\b(Layer|Label|DynamicLable|DynamicLabel|Container|Image|TextStyle|DynamicTextStyle|Node)\\b\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "entity.name.type.luma" },
        "2": { "name": "keyword.other.use.luma" }
      }
    },

    "string": {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.luma",
      "patterns": [
        {
          "match": "\\\\.",
          "name": "constant.character.escape.luma"
        }
      ]
    },

    "color": {
      "match": "#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?\\b",
      "name": "constant.other.color.luma"
    },

    "size": {
      "match": "\\b\\d+(?:\\.\\d+)?(x)\\d+(?:\\.\\d+)?\\b",
      "name": "constant.numeric.luma",
      "captures": {
        "1": { "name": "keyword.operator.size.luma" }
      }
    },

    "number": {
      "match": "\\b\\d+(?:\\.\\d+)?\\b",
      "name": "constant.numeric.luma"
    },

    "boolean": {
      "match": "\\b(true|false)\\b",
      "name": "constant.language.boolean.luma"
    },

    "image-handle": {
      "match": "\\b(image_handle)\\b(\\s*:\\s*)([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "variable.other.property.luma" },
        "2": { "name": "punctuation.definition.generic.begin.luma" },
        "3": { "name": "entity.name.type.luma" }
      }
    },

    "property": {
      "match": "\\b[a-z_][a-z0-9_]*\\b(?=\\s*:(?!:))",
      "name": "variable.other.property.luma"
    },

    "enum": {
      "match": "\\b(TopLeft|TopCenter|TopRight|CenterLeft|CenterCenter|CenterRight|BottomLeft|BottomCenter|BottomRight|Default)\\b",
      "name": "entity.name.type.enum.luma"
    },

    "name-ref": {
      "match": "\\b[A-Z][A-Za-z0-9_]*\\b",
      "name": "keyword.other.use.luma"
    },

    "punct": {
      "match": "[;,:(){}\\[\\]]",
      "name": "punctuation.definition.generic.begin.luma"
    }
  }
}